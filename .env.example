# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side only, used by AI/insights routes
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — server-side only, used by /api/ai/*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase auth redirect URL (set in Supabase dashboard instead for prod)
# SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
